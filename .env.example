PORT=3000
PUBLIC_URL=http://localhost:3000
DATA_DIR=./data
TZ=America/Sao_Paulo
WHATSAPP_ENABLED=false
WHATSAPP_BOT_PHONE=
# Identificadores de grupos, separados por vírgula. Exige bot administrador.
WHATSAPP_GROUP_IDS=
DAILY_CRON=0 6 * * *
EXPIRATION_CRON=*/10 * * * *
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=
# Retorno HTTPS do checkout em produção.
PAYMENT_RETURN_URL=https://example.com/obrigado
PAGSEGURO_TOKEN=
PAGSEGURO_SANDBOX=true
# Fallback de pagamento avulso de 1 mês: não equivale a débito recorrente.
PAGSEGURO_ALLOW_ONE_TIME_FALLBACK=false
SPIRITUAL_AI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
EVENT_SOURCES_FILE=
# E-mail do operador para identificar o cliente Nominatim. Vazio desabilita geocoding.
GEOCODING_CONTACT=
EVENT_RADIUS_KM=20
SESSION_TTL_MINUTES=30
# Limita retenção de conversas privadas no banco.
HISTORY_RETENTION_DAYS=7
