# Copiar com permissão 600 para /opt/bible-daily-events/shared/app.env.
# O formato raw do Compose preserva $, # e espaços nos valores: não use aspas.
# Nunca versionar o arquivo preenchido. Os campos secretos ficam somente na VM.
TZ=America/Sao_Paulo
PUBLIC_URL=https://fe.suaempresa.com.br
PAYMENT_RETURN_URL=https://fe.suaempresa.com.br/obrigado
WHATSAPP_ENABLED=false
WHATSAPP_BOT_PHONE=
WHATSAPP_GROUP_IDS=
DAILY_CRON=0 6 * * *
EXPIRATION_CRON=*/10 * * * *
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=
PAGSEGURO_TOKEN=
PAGSEGURO_SANDBOX=true
PAGSEGURO_ALLOW_ONE_TIME_FALLBACK=false
SPIRITUAL_AI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GEOCODING_CONTACT=
EVENT_RADIUS_KM=20
SESSION_TTL_MINUTES=30
HISTORY_RETENTION_DAYS=7
# O Compose fixa PORT=3000, DATA_DIR, EVENT_SOURCES_FILE e TRUST_PROXY.
# OPENAI_API_KEY também é aceito, mas prefira SPIRITUAL_AI_API_KEY.
