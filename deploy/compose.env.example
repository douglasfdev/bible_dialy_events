# Variáveis de interpolação do Compose: /opt/bible-daily-events/shared/compose.env
# Não confundir com app.env, que contém as variáveis lidas pelo Node.
APP_DOMAIN=fe.suaempresa.com.br
ACME_EMAIL=infra@suaempresa.com.br
TRUST_PROXY=1
DATA_VOLUME_NAME=bible-daily-events-data
# APP_IMAGE, APP_ENV_FILE e EVENT_SOURCES_PATH são definidos pelo deploy.
